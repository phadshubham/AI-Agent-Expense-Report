# ====================================
# AI Expense Report Agent Configuration
# ====================================

# Ollama model name (must be pulled first: ollama pull qwen3:4b)
OLLAMA_MODEL=qwen3:4b

# Ollama API base URL
OLLAMA_BASE_URL=http://localhost:11434

# Path to expense CSV data
EXPENSE_CSV_PATH=data/expenses.csv

# Path to persistent SQLite memory database
EXPENSE_MEMORY_DB_PATH=data/expense_memory.db

# ====================================
# Email Configuration (Resend API)
# ====================================
# Get your free API key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
DEFAULT_RECIPIENT_EMAIL=
